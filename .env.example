# LiveKit Cloud Credentials
LIVEKIT_URL=wss://your-project-subdomain.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Google Gemini API Key (Required for Gemini Multimodal Live Realtime Model)
# Get from https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_gemini_api_key

# Tavily Search API Key (Required for live web search and news)
# Get from https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key

# Optional: Beyond Presence (Bey) Avatar ID & settings
BEY_AVATAR_ID=694c83e2-8895-4a98-bd16-56332ca3f449
ENABLE_BEY_AVATAR=true

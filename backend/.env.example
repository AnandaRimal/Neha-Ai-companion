# LiveKit Server or Cloud project credentials
LIVEKIT_URL=wss://your-livekit-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Tavily Search API key (for real-time web search and live news)
TAVILY_API_KEY=your_tavily_api_key

# Google Gemini API key (for Gemini Realtime Multimodal Live API)
GOOGLE_API_KEY=your_google_api_key

# Optional: Beyond Presence avatar stream ID (leave empty for audio-only)
BEY_AVATAR_ID=694c83e2-8895-4a98-bd16-56332ca3f449
